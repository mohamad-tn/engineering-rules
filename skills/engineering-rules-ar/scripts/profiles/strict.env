# Profile: strict. Teams, regulated or security-sensitive products, public libraries.
# Every standard gate must run and pass, including format, lint, types and audit.
WARN_LINES=300
FAIL_LINES=600
DOCS_MAP_MODE=on
STACK_REQUIRE=deps,test,build
STACK_STRICT=1
AUDIT_LEVEL=moderate
DOCS_LINT_SCOPE=all

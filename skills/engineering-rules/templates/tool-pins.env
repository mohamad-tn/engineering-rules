# Versions and checksums of the tools the gates download or run. Copy this
# file to .github/tool-pins.env. The values below were checked against the
# official release checksum files and the npm registry when this package was
# built; re-check them and update when you adopt (newer releases exist over
# time). An EMPTY value makes the gate fail loudly instead of running an
# unpinned or unverified tool. Update all pins in one pull request, together
# with .pre-commit-config.yaml and your versions record.
#
# Where to get a SHA-256: the release page of each tool publishes a checksums
# file; use the entry for the exact archive named below.

# gitleaks: archive gitleaks_<version>_linux_x64.tar.gz
GITLEAKS_VERSION=8.30.1
GITLEAKS_SHA256=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb

# lychee: archive lychee-x86_64-unknown-linux-gnu.tar.gz (release tag lychee-v<version>)
LYCHEE_VERSION=0.24.2
LYCHEE_SHA256=1f4e0ef7f6554a6ed33dd7ac144fb2e1bbed98598e7af973042fc5cd43951c9a

# markdownlint-cli2: run through npx at this exact version
MARKDOWNLINT_CLI2_VERSION=0.23.3

# renovate: provides renovate-config-validator, run through npx at this exact version
RENOVATE_VERSION=44.168.4

# The preset renovate.json must extend, and the preset file's path in this
# repository (used to validate it too). Leave RENOVATE_PRESET_FILE empty if
# the preset lives in another repository.
RENOVATE_PRESET="local><org>/<project>//renovate/default"
RENOVATE_PRESET_FILE="renovate/default.json"

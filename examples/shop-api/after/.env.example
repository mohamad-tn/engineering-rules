# Copy to .env (never commit it). Values come from your secret store.
DATABASE_URL=
PAYMENT_API_KEY=
CURRENCY=
TIMEZONE=
# Non-negative decimal fraction; for example, 0.08 means 8%.
TAX_RATE=
# Optional positive whole number of milliseconds; blank uses the 5000 ms default.
# The maximum is 2147483647 to stay within Node's supported timer range.
PAYMENT_TIMEOUT_MS=
